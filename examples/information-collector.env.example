# Collector-only configuration. Keep actual credentials and task files private.
PIXORA_SERVER=https://your-pixora-host.example
PIXORA_WRITE_TOKEN=replace-with-your-server-write-token
PIXORA_GITHUB_REPOSITORY=kongjiestak/pixora
PIXORA_RSS_URL=https://github.blog/changelog/feed/
PIXORA_TASKS_FILE=/private/path/tasks.json
# Optional city weather. No device geolocation is used.
PIXORA_WEATHER_LATITUDE=31.2304
PIXORA_WEATHER_LONGITUDE=121.4737
PIXORA_WEATHER_ENTITY=shanghai
PIXORA_WEATHER_LABEL=Shanghai
