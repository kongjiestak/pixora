# Store the real file as /etc/pixora/system-collector.env, root:root mode 0600.
# Use the existing trusted collector write capability, never a device read token.
PIXORA_WRITE_TOKEN=replace-with-your-server-write-token
PIXORA_SERVER=http://127.0.0.1:8000
PIXORA_SYSTEM_ENTITY=my-linux-host
PYTHONDONTWRITEBYTECODE=1
